{
  "app": {
    "name": "RecordBase - Records Database System",
    "version": "2.0.0",
    "author": "apocalypse coder0"
  },
  "database": {
    "driver": "mysql",
    "host": "localhost",
    "port": 3306,
    "name": "recordbase",
    "user": "root",
    "password": "",
    "charset": "utf8mb4",
    "pool": {
      "min": 2,
      "max": 10,
      "idle_timeout_ms": 30000
    }
  },
  "api": {
    "base_url": "http://localhost:8080/api/v1",
    "host": "0.0.0.0",
    "port": 8080,
    "max_retries": 3,
    "timeout_ms": 5000,
    "cors": {
      "enabled": true,
      "allowed_origins": [
        "*"
      ]
    }
  },
  "rows": {
    "default_total": 150,
    "max_per_entry": 4
  },
  "dataset": {
    "path": "database/dataset.sql",
    "database_file": "database.dat",
    "save_on_exit": true
  },
  "logging": {
    "level": "info",
    "file": "logs/recordbase.log"
  }
}